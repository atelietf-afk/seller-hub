# Banco Postgres (Neon). Use a connection string "pooled" do painel do Neon.
DATABASE_URL=postgres://usuario:senha@ep-xxxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require

# Login (Better Auth). Segredo: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Mercado Livre (developers.mercadolivre.com.br → Minhas aplicações)
ML_CLIENT_ID=
ML_CLIENT_SECRET=
# Precisa ser HTTPS e estar cadastrada no app do ML
ML_REDIRECT_URI=https://seu-dominio.vercel.app/api/ml/callback

# 32 bytes em base64 para criptografar os tokens do ML: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Claude (console.anthropic.com)
ANTHROPIC_API_KEY=

# Protege as rotas /api/cron/* (a Vercel envia automaticamente): openssl rand -hex 32
CRON_SECRET=
