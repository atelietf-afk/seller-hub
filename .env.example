# Banco Postgres (Neon). Use a connection string "pooled" do painel do Neon.
DATABASE_URL=postgres://usuario:senha@ep-xxxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require

# Login (Better Auth). Segredo: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Mercado Livre (developers.mercadolivre.com.br → Minhas aplicações)
ML_CLIENT_ID=
ML_CLIENT_SECRET=
# Precisa ser HTTPS e estar cadastrada no app do ML
ML_REDIRECT_URI=https://seu-dominio.vercel.app/api/ml/callback

# 32 bytes em base64 para criptografar os tokens do ML: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Claude (console.anthropic.com)
ANTHROPIC_API_KEY=

# Protege as rotas /api/cron/* (a Vercel envia automaticamente): openssl rand -hex 32
CRON_SECRET=

# WhatsApp Cloud API (developers.facebook.com → seu app → WhatsApp). Opcional: sem isso os relatórios não vão para o WhatsApp.
# Use um token permanente de usuário do sistema (Business Settings → System users), não o temporário de 24h.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Modelo aprovado (veja o README). Padrões: relatorio_vendas / pt_BR / v23.0
WHATSAPP_TEMPLATE=relatorio_vendas
WHATSAPP_TEMPLATE_LANG=pt_BR

# Liga os botões que alteram e criam campanhas de Product Ads pela API. Deixe desligado:
# hoje o ML responde 401 "User does not have permission to write" para vendedores do Brasil.
# ADS_WRITE_ENABLED=true
